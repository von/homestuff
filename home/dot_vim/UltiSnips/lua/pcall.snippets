# Snippets for pcall() and xpcall(): https://www.lua.org/pil/8.5.html
#
snippet pcall "Protected call"
local status, result = xpcall(${1:func}, debug.traceback)
if status then
  -- Success. result contains returned value from $1
else
  -- Called failed. result has error message
  ${2:errorfunc}("Error calling $1: " .. result)
end
endsnippet

snippet xpcall "Extended protected call"
local status, result = xpcall(${1:func}, debug.traceback)
if status then
  -- Success. result contains returned value from $1
else
  -- Called failed. result has error message
  ${2:errorfunc}("Error calling $1: " .. result)
end
endsnippet
